# FastAPI & Security
# Generate a strong secret key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-strong-random-secret-key-change-in-all-environments
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Faster-Whisper Configuration (local/offline voice-to-text)
# Model options: tiny, base, small, medium, large-v3
# For CPU use: FASTER_WHISPER_DEVICE=cpu and FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Hugging Face Hub (optional, improves rate limits/download speed for model files)
# Create token from: https://huggingface.co/settings/tokens
HF_TOKEN=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

# Windows: set to 1 to silence symlink cache warnings if Developer Mode is disabled
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Optional: reduce noisy hub warnings in logs (debug|info|warning|error|critical)
HF_HUB_VERBOSITY=error

# Google Cloud Configuration
# Get credentials from: https://cloud.google.com/docs/authentication/getting-started
# Set this path or use Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-cloud-credentials.json

# Database
DATABASE_URL=sqlite:///./niyantrit.db

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False

# Blockchain Configuration (Ethereum Sepolia Testnet ONLY)
# Get free test ETH from: https://sepoliafaucet.com
# Get Infura API key from: https://infura.io
# WARNING: Never use mainnet keys here or commit private keys to version control
# For production, use AWS KMS, Google Cloud KMS, or hardware wallets
ETHEREUM_PROVIDER_URL=https://sepolia.infura.io/v3/your-infura-project-id
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_PRIVATE_KEY=0xtestnet-private-key-only-never-mainnet

# Optional: Google Maps API (Phase 2)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
